<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.theworldavatar.com/kg/ontotechnicalsystem/"
     xml:base="https://www.theworldavatar.com/kg/ontotechnicalsystem/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontotechnicalsystem="https://www.theworldavatar.com/kg/ontotechnicalsystem/">
    <owl:Ontology rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/">
        <dc:date>14 September 2026</dc:date>
        <rdfs:comment>An ontology for technical systems.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/gitCommitHash -->


    <owl:AnnotationProperty rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/composedOf -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/composedOf">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/technical_system.owl#TechnicalSystem"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontodevice/Device"/>
        <rdfs:comment>A relationship that describes the devices that a technical system is composed of.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>composed of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/containsSystem -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/containsSystem">
        <rdfs:domain rdf:resource="https://w3id.org/bot#Zone"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/technical_system.owl#TechnicalSystem"/>
        <rdfs:comment>A relationship that describes the technical systems contained in a zone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>contains system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/hasID -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/hasID">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/technical_system.owl#TechnicalSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A relationship that describes the ID assigned to a technical system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>has ID</rdfs:label>
    </owl:DatatypeProperty>
    


