    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/CrossFlowFiltrationSystem">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/FiltrationSystem"/>
        <rdfs:comment>A system that utilizes cross-flow filtration or tangential flow filtration and it is usually used for chemical engineering, biochemical engineering and protein purification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>Cross-flow filtration system</rdfs:label>
    </owl:Class>
    


