        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/LabEquipmentSystem"/>
        <rdfs:comment>A system for diluting solutions in a lab environment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>Dilution system</rdfs:label>
    </owl:Class>
    


