    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/AerosolDilutionSystem -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/AerosolDilutionSystem">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/DilutionSystem"/>
        <rdfs:comment>A system for diluting aerosols.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>Aerosol dilution system</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/BurnerSystem -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/BurnerSystem">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/LabEquipmentSystem"/>
        <rdfs:comment>A system for experiments that require burning via exposure to fire.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>Burner system</rdfs:label>
    </owl:Class>
    


