    <!-- https://www.theworldavatar.com/kg/ontotechnicalsystem/ComputerSystem -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontotechnicalsystem/ComputerSystem">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/technical_system.owl#TechnicalSystem"/>
        <rdfs:comment>A system of computer parts working together as a computer or a computer part.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotechnicalsystem/"/>
        <rdfs:label>Computer system</rdfs:label>
    </owl:Class>
    


