    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/technical_system.owl#TechnicalSystem -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/technical_system.owl#TechnicalSystem"/>
    


    <!-- https://w3id.org/bot#Zone -->


