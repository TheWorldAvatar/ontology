<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.theworldavatar.com/kg/ontozoning/"
     xml:base="https://www.theworldavatar.com/kg/ontozoning/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontozoning="https://www.theworldavatar.com/kg/ontozoning/">
    <owl:Ontology rdf:about="https://www.theworldavatar.com/kg/ontozoning/">
        <dc:date>14 September 2026</dc:date>
        <rdfs:comment>OntoZoning is an ontology developed to represent relationships between zones, their land use types and land uses.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- https://www.theworldavatar.com/kg/ontozoning/gitCommitHash -->


    <owl:AnnotationProperty rdf:about="https://www.theworldavatar.com/kg/ontozoning/gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.theworldavatar.com/kg/ontozoning/hasLandUseType -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontozoning/hasLandUseType">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplot/Plot"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUseType"/>
        <rdfs:comment>A relationship indicating the plot and its associated land use type. This association may be established by the relevant competent authority.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontozoning/"/>
        <rdfs:label>has land use type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontozoning/hasPlot -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontozoning/hasPlot">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontozoning/Zone"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplot/Plot"/>
        <rdfs:comment>A relationship that indicates the plots that are within the boundaries of the specified zone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontozoning/"/>
        <rdfs:label>has plot</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontozoning/subcategoryOf -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontozoning/subcategoryOf">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUse"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUse"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontozoning/"/>
        <rdfs:label>subcategory of</rdfs:label>
    </owl:ObjectProperty>
    


