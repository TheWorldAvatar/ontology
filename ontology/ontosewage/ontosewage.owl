    <!-- https://www.theworldavatar.com/kg/ontosewage/hasShape -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontosewage/hasShape">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/Cover"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/CrossSection"/>
