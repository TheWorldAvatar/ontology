    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontosewage/hasLength -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontosewage/hasLength">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Pipe"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/Flume"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/Shaft"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment>A relationship between a pipe or a flume or a shaft and length.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontosewage/"/>
        <rdfs:label>has length</rdfs:label>
