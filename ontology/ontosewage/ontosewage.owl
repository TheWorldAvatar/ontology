<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.theworldavatar.com/kg/ontosewage/"
     xml:base="https://www.theworldavatar.com/kg/ontosewage/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontosewage="https://www.theworldavatar.com/kg/ontosewage/">
    <owl:Ontology rdf:about="https://www.theworldavatar.com/kg/ontosewage/">
        <dc:date>14 September 2026</dc:date>
        <rdfs:comment>OntoSewage is an ontology developed for representing sewerage system.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- https://www.theworldavatar.com/kg/ontosewage/gitCommitHash -->


    <owl:AnnotationProperty rdf:about="https://www.theworldavatar.com/kg/ontosewage/gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#wktLiteral -->


    <rdfs:Datatype rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://semanticscience.org/resource/SIO_000061 -->


    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000061">
        <rdfs:domain rdf:resource="https://schema.org/location"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdfs.co/juso/District"/>
                    <rdf:Description rdf:about="http://rdfs.co/juso/Street"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:comment>A relationship between a measure and the respective unit of measure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Depth"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Distance"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Thickness"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Width"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/Inclination"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasLocation -->


    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/Manhole"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/BranchConnection"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://schema.org/location"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/OntoCAPE.owl#hasPart -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocape/OntoCAPE.owl#hasPart">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontosewage/SewerageNetwork"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontosewage/SewerageComponent"/>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/OntoCAPE.owl"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/digitalconstruction/0.3/BuildingMaterials#hasMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/digitalconstruction/0.3/BuildingMaterials#hasMaterial">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/ConstructionProperties"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontosewage/Cover"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/digitalconstruction/0.3/BuildingMaterials#Material"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/digitalconstruction/0.3/BuildingMaterials"/>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontosewage/hasBranchPipe -->


