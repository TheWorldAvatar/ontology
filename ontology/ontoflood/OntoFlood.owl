        <rdfs:label>Sluice</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/SoilMoisture -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/SoilMoisture">
