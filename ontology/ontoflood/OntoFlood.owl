<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.theworldavatar.com/kg/ontoflood/"
     xml:base="https://www.theworldavatar.com/kg/ontoflood/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontoflood="https://www.theworldavatar.com/kg/ontoflood/">
    <owl:Ontology rdf:about="https://www.theworldavatar.com/kg/ontoflood/">
        <dc:date>10 September 2026</dc:date>
        <rdfs:comment>The Flood Risk Monitoring ontology (OntoFlood) is an ontology developed for representing flood events as well as flood warnings, together with the risk and (potential) impacts imposed by those events.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/gitCommitHash -->


    <owl:AnnotationProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon -->


    <rdfs:Datatype rdf:about="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://environment.data.gov.uk/flood-monitoring/def/core/currentWarning -->


    <owl:ObjectProperty rdf:about="http://environment.data.gov.uk/flood-monitoring/def/core/currentWarning">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodArea"/>
        <rdfs:range rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>current warning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002354 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002354">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500002"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/envo.owl"/>
        <rdfs:label>formed as result of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/"/>
        <rdfs:label>has unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfMoney"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Area"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/"/>
        <rdfs:label>has value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="https://www.w3.org/2006/time"/>
        <rdfs:label>has beginning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:isDefinedBy rdf:resource="https://www.w3.org/2006/time"/>
        <rdfs:label>has end</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/affects -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/affects">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoflood/EnvironmentalComponent"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoflood/InfrastructureComponent"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoflood/Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>A relationship between a Flood and affected entities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasAdministrativeDistrict -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasAdministrativeDistrict">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Location"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/AdministrativeDistrict"/>
        <rdfs:comment>A relationship between a location and an encompassing administrative district.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has administrative district</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasAlertOrWarningHistory -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasAlertOrWarningHistory">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodArea"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodAlertOrWarningHistory"/>
        <rdfs:comment>A relationship between a Flood Area and its collection of previous flood warnings and alerts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has historical warning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasArealExtent -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasArealExtent">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Location"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/ArealExtentPolygon"/>
        <rdfs:comment>Geospatial extent of an event&apos;s footprint.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has areal extent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasAttachedWaterBody -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasAttachedWaterBody">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodArea"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000063"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>attached water body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasFloodSource -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasFloodSource">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodForecast"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodSource"/>
        <rdfs:comment>A relationship between a flood forecast and its water source.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has flood source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasGeospatialDistribution -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasGeospatialDistribution">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/ArealDistribution"/>
        <rdfs:comment>A relationship between a quantity and its geospatial field distribution.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has geospatial distribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasInputParameter -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasInputParameter">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/InputParameter"/>
        <rdfs:comment>Relates a flood forecast model to its input parameters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has Input Parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasIntensity -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasIntensity">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment>A relationship between a Flood and associated quantities describing its intensity (e.g. water depth, flow velocity).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has intensity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasLikelihood -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasLikelihood">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/RiskLevel"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Likelihood"/>
        <rdfs:comment>A relationship between a risk level and the underlying likelihood.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has likelihood</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasLocation -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://environment.data.gov.uk/flood-monitoring/def/core/FloodArea"/>
                    <rdf:Description rdf:about="http://sweetontology.net/phen/Event"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoflood/FloodForecast"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Location"/>
        <rdfs:comment>A relationship between a (forecasted) event and its geospatial location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasMonetaryValue -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasMonetaryValue">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Impact"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfMoney"/>
        <rdfs:comment>A relationship between an Impact and the quantification of its cumulative effects in monetary terms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has monetary value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasOutputParameter -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasOutputParameter">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/OutputParameter"/>
        <rdfs:comment>Relates a flood forecast model to its output parameters.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has Output Parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasPotentialImpact -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasPotentialImpact">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/RiskLevel"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/PotentialImpact"/>
        <rdfs:comment>A relationship between a risk level and the underlying impact potential.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has potential impact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasRiskLevel -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasRiskLevel">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodForecast"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/RiskLevel"/>
        <rdfs:comment>A relationship between a flood forecast and its anticipated risk.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has risk level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasSeverity -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasSeverity">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Severity"/>
        <rdfs:comment>A relationship between a Flood Alert/Warning and its severity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasTimeInterval -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasTimeInterval">
        <rdfs:domain rdf:resource="http://sweetontology.net/phen/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:comment>A relationship between an event and the time interval associated with the duration of the event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has time interval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasTotalAffectedArea -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasTotalAffectedArea">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/InfrastructureComponent"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Area"/>
        <rdfs:comment>A relationship between an affected Infrastructure Component and the corresponding total area affected.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has affected area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasTotalMonetaryValue -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasTotalMonetaryValue">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/InfrastructureComponent"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfMoney"/>
        <rdfs:comment>A relationship between an affected Infrastructure Component and the corresponding financial damage estimate.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has total monetary value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/includesDevelopmentOf -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/includesDevelopmentOf">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodProtectionInfrastructure"/>
        <rdfs:comment>Links flood preparedness measures to the development of flood protection infrastructure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>includes Development Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/predicts -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/predicts">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodForecast"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
        <rdfs:comment>A relationship between a flood forecast and the actual flood event it refers to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>predicts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/reducesImpactOf -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/reducesImpactOf">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
        <rdfs:comment>Describes the relationship between flood protection infrastructure and its mitigation of flood impacts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>reduces Impact Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/resultsIn -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/resultsIn">
        <rdfs:domain rdf:resource="http://sweetontology.net/phen/Event"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Impact"/>
        <rdfs:comment>A relationship between an Event and its effects.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>results in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/storesLocalFloodWaterFrom -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/storesLocalFloodWaterFrom">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/LocalRunOff"/>
        <rdfs:comment>Describes how a local flood storage area holds water from local runoff sources.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>stores Local Flood Water From</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/warnsAbout -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/warnsAbout">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
        <rdfs:comment>A relationship between a Flood Alert/Warning and the actual flood event it refers to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>warns about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontotimeseries/hasTimeSeries -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontotimeseries/hasTimeSeries">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodAlertOrWarningHistory"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontotimeseries/TimeSeries"/>
        <rdfs:comment>A relationship between the collection of previous flood warnings and alerts and their actual time series history.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has time series</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://environment.data.gov.uk/flood-monitoring/def/core/message -->


    <owl:DatatypeProperty rdf:about="http://environment.data.gov.uk/flood-monitoring/def/core/message">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>message</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://environment.data.gov.uk/flood-monitoring/def/core/timeMessageChanged -->


    <owl:DatatypeProperty rdf:about="http://environment.data.gov.uk/flood-monitoring/def/core/timeMessageChanged">
        <rdfs:domain rdf:resource="http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>time message changed</rdfs:label>
