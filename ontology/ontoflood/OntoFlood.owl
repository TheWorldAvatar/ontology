        <rdfs:label>Minimal impact</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/MinorImpact -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/MinorImpact">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoflood/PotentialImpact"/>
