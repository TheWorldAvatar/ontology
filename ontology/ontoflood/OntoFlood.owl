    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/SeaSurfaceTemperature -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/SeaSurfaceTemperature">
