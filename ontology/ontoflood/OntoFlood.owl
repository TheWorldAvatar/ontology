        <rdfs:label>Significant impact</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/SlopeOfArea -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/SlopeOfArea">
        <rdfs:comment>Measures the gradient of the land surface, affecting water runoff and flood likelihood.</rdfs:comment>
