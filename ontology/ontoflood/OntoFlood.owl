    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/RaisedArea">
        <rdfs:comment>An elevated area designed to stay dry during floods, providing refuge or protection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Raised Area</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/RegionalGovernment -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/RegionalGovernment">
        <rdfs:comment>Refers to a sub-national level of government responsible for flood management within a region.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Regional Government</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/ResidentialArea -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/ResidentialArea">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoflood/ArealInfrastructure"/>
        <rdfs:comment>Material infrastructure in form of residential buildings.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>ResidentialArea</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/RiskLevel -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/RiskLevel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.theworldavatar.com/kg/ontoflood/hasLikelihood"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Likelihood"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.theworldavatar.com/kg/ontoflood/hasPotentialImpact"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.theworldavatar.com/kg/ontoflood/PotentialImpact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A measure of hazard potential defined by expected likelihood and forecasted impact.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Risk level</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/RiverDensity -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/RiverDensity">
        <rdfs:comment>Measures the number and concentration of rivers in an area, influencing flood potential.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>River Density</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/RiverDiversionWork -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/RiverDiversionWork">
        <rdfs:comment>Projects aimed at diverting rivers to reduce flood risks in vulnerable areas.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>River Diversion Work</rdfs:label>
    </owl:Class>
    


