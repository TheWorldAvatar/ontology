    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/LocalRunOff">
        <rdfs:comment>Refers to water that flows over the land surface in a localized area, often contributing to floods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Local Run Off</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/LocalStructuralProvision -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/LocalStructuralProvision">
        <rdfs:comment>Refers to small-scale, local infrastructure designed to mitigate floods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Local Structural Provision</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/Location -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/Location">
        <rdfs:comment>The location associated with an event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Location</rdfs:label>
    </owl:Class>
    


