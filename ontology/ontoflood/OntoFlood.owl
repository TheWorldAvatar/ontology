        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Land Use Land Cover</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/Likelihood -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/Likelihood">
        <rdfs:comment>The probability of a forecasted flood event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Likelihood</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/LivingBeing -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/LivingBeing">
        <rdfs:comment>including humans and animals, that may be impacted by earthquakes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Living Being</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/LocalEmbankment -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/LocalEmbankment">
        <rdfs:comment> A smaller embankment used for local flood protection efforts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Local Embankment</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/LocalFloodStorageArea -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/LocalFloodStorageArea">
