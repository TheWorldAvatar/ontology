    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/WaterStorage -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/WaterStorage">
        <rdfs:comment>Indicates the capability of natural or artificial features to store water and mitigate flooding.</rdfs:comment>
        <rdfs:comment>Refers to the capacity of reservoirs or natural features to store water, relevant to flood risk.</rdfs:comment>
