    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/WaterVelocity -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/WaterVelocity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Velocity"/>
