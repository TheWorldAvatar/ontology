    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/ProvisioningNetwork">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoflood/NetworkInfrastructure"/>
