        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Low likelihood</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/MediumLikelihood -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/MediumLikelihood">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Likelihood"/>
        <rdfs:comment>The likelihood of a flood with medium probability for a flood to materialise (e.g. 40-60%)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Medium likelihood</rdfs:label>
    </owl:Class>
    


