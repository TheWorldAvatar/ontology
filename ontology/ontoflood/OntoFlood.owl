    <!-- https://www.theworldavatar.com/kg/ontoflood/NetworkInfrastructure -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/NetworkInfrastructure">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoflood/InfrastructureComponent"/>
        <rdfs:comment>Network systems, i.e. installations and facilities spreading across land.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Network infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/OutputParameter -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/OutputParameter">
