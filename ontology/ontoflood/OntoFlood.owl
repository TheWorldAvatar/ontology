        <rdfs:label>Minor impact</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/MobilityNetwork -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/MobilityNetwork">
