        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has classification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasEffectiveDate -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasEffectiveDate">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/FloodForecast"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A relationship between a flood forecast and the date it applies to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasImpactLevel -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasImpactLevel">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/PotentialImpact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Numerical categorisation of the impact potential of a flood event (e.g. on a linear scale from 1 to 4).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has impact level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasLikelihoodScore -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasLikelihoodScore">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Likelihood"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Numerical categorisation of the likelihood of a flood event (e.g. on a linear scale from 1 to 4).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has likelihood score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasSeverityLevel -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasSeverityLevel">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Severity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Numerical categorisation of the severity level of a flood warning/alert (e.g. on a linear scale from 1 to 4).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has severity level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasTotalCount -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasTotalCount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoflood/InfrastructureComponent"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoflood/Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The total number of affected entities (e.g. people, particular infrastructure components)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/hasWGS84LatitudeLongitude -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoflood/hasWGS84LatitudeLongitude">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Location"/>
        <rdfs:range rdf:resource="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
        <rdfs:comment>Centerpoint of an event&apos;s footprint in WGS84 coordinates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>has WGS84 latitude longitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontotimeseries/hasRDB -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontotimeseries/hasRDB">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontotimeseries/TimeSeries"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotimeseries/"/>
        <rdfs:label>has RDB link</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontotimeseries/hasTimeUnit -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontotimeseries/hasTimeUnit">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontotimeseries/TimeSeries"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontotimeseries/"/>
        <rdfs:label>has time unit</rdfs:label>
    </owl:DatatypeProperty>
    


