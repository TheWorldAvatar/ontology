    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/RoadCulvert">
        <rdfs:comment>A structure allowing water to flow under a road, preventing flooding of the road.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
