        <rdfs:label>Severe impact</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/Severity -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/Severity">
        <rdfs:comment>The potential impact of the flood associated with a flood warning/alert.</rdfs:comment>
