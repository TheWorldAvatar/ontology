    <!-- http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning -->


    <owl:Class rdf:about="http://environment.data.gov.uk/flood-monitoring/def/core/FloodAlertOrWarning">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.theworldavatar.com/kg/ontoflood/hasSeverity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.theworldavatar.com/kg/ontoflood/Severity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.theworldavatar.com/kg/ontoflood/warnsAbout"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000710"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Flood alert or warning</rdfs:label>
    </owl:Class>
    


    <!-- http://environment.data.gov.uk/flood-monitoring/def/core/FloodArea -->


    <owl:Class rdf:about="http://environment.data.gov.uk/flood-monitoring/def/core/FloodArea">
