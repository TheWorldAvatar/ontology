        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Output Parameter</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/Population -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/Population">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoflood/LivingBeing"/>
        <rdfs:comment>People who inhabit a territory or state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Population</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/PotentialImpact -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/PotentialImpact">
        <rdfs:comment>The potential impacts of a forecasted flood event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
