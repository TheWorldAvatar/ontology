    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/SandbagStack">
        <rdfs:comment>A temporary flood defense structure made by stacking sandbags to block or divert water.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Sandbag Stack</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/SeaLevel -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/SeaLevel">
        <rdfs:comment>Refers to the average height of the ocean&apos;s surface, critical in flood forecasting for coastal areas.</rdfs:comment>
