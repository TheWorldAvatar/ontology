        <rdfs:comment>Refers to systems designed to remove excess water from the land, reducing flood risk.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoflood/"/>
        <rdfs:label>Land Drainage</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoflood/LandUseLandCover -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoflood/LandUseLandCover">
