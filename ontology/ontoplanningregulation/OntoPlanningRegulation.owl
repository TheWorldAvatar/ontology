<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.theworldavatar.com/kg/ontoplanningregulation/"
     xml:base="https://www.theworldavatar.com/kg/ontoplanningregulation/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontoplanningregulation="https://www.theworldavatar.com/kg/ontoplanningregulation/">
    <owl:Ontology rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/">
        <dc:date>14 September 2026</dc:date>
        <rdfs:comment>OntoPlanningRegulation is an ontology developed to describe the regulations imposed for urban planning purposes.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/gitCommitHash -->


    <owl:AnnotationProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/allowsAbsoluteHeight -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/allowsAbsoluteHeight">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/AbsoluteHeight"/>
        <rdfs:comment>A relationship defining the allowable absolute height that a given planning regulation has provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>allows absolute height</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/allowsBuildingHeight -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/allowsBuildingHeight">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingHeight"/>
        <rdfs:comment>A relationship defining the allowable building height that a given planning regulation has provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>allows building height</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/allowsBuildingMassRatio -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/allowsBuildingMassRatio">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingMassRatio"/>
        <rdfs:comment>A relationship defining the allowable building mass ratio that a given planning regulation has provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>allows building mass ratio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/allowsGrossPlotRatio -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/allowsGrossPlotRatio">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/GrossPlotRatio"/>
        <rdfs:comment>A relationship defining the allowable gross plot ratio that a given planning regulation has provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>allows gross plot ratio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/allowsSiteCoverage -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/allowsSiteCoverage">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/SiteCoverage"/>
        <rdfs:comment>A relationship defining the allowable site coverage that a given planning regulation has provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>allows site coverage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/allowsUse -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/allowsUse">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUse"/>
        <rdfs:comment>A relationship that denotes the allowable land uses within a specific land use type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>allows use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/applicableFor -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/applicableFor">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/UseQuantum"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUse"/>
        <rdfs:comment>A relationship that links the use quantum retriction to its applicable land use.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>applicable for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/appliesTo -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/appliesTo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoplot/Plot"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontozoning/LandUseType"/>
                    <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontozoning/Zone"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>This relationship serves as a link to signify the direct relevance and applicability of the planning regulation to that specific urban entity.  In the case of land use regulations, they are applicable only for land use types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>applies to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/doesNotAllowUse -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/doesNotAllowUse">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUse"/>
        <rdfs:comment>A relationship that denotes the land uses that are not permissible within a specific land use type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>does not allow use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/hasMaxUseQuantum -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/hasMaxUseQuantum">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/UseQuantum"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>has max use quantum</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/hasMinUseQuantum -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/hasMinUseQuantum">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/UseQuantum"/>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>has min use quantum</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/isLegislatedBy -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/isLegislatedBy">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/CompetentAuthority"/>
        <rdfs:comment>A relationship that indicates which competent authority has establish the specified planning regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>is legislated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/isRelativeTo -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/isRelativeTo">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingHeight"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/Datum"/>
        <rdfs:comment>A relationship that links the datum or reference point that underpins any building height restrictions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>is relative to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/mayAllowUse -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/mayAllowUse">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUse"/>
        <rdfs:comment>A relationship that denotes the land uses that may be allowed within a specific land use type, subject to the approval of the competent authority.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>may allow use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/override -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/override">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:comment>This relationship denotes the prioritization of a specific planning regulation over others. It aims to accommodate the diverse hierarchy of regulations observed across different cities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>override</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/requiresFloorToFloorHeight -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/requiresFloorToFloorHeight">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/FloorToFloorHeight"/>
        <rdfs:comment>A relationship defining the required floor to floor height of an urban entity which is enforced by a planning regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>requires floor to floor height</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/requiresPartyWall -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/requiresPartyWall">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PartyWall"/>
        <rdfs:comment>A relationship defining the required party wall for an urban entity which is enforced by a planning regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>requires party wall</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/requiresRoadBuffer -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/requiresRoadBuffer">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/RoadCategory"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/RoadBuffer"/>
        <rdfs:comment>A relationship defining the required road buffer for an urban entity which is enforced by a planning regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>requires road buffer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/requiresSetback -->


    <owl:ObjectProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/requiresSetback">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/Setback"/>
        <rdfs:comment>A relationship defining the required setback of an urban entity which is enforced by a planning regulation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>requires setback</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/forCornerPlot -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/forCornerPlot">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>A boolean indicator indicating if the regulation applies only to corner plots.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>for corner plot</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/forFringePlot -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/forFringePlot">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>A boolean indicator indicating if the regulation applies only to fringe plots.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>for fringe plot</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/isAwaitingDetailedGPREvaluation -->


    <owl:DatatypeProperty rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/isAwaitingDetailedGPREvaluation">
        <rdfs:domain rdf:resource="https://www.theworldavatar.com/kg/ontoplot/Plot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>A boolean indicating if the plot is currently awaiting detailed evaluation for gross plot ratio.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>is awaiting detailed gross plot ratio evaluation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Distance -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Distance"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Height -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Percent -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Percent"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Ratio -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Ratio"/>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/AbsoluteHeight -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/AbsoluteHeight">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
        <rdfs:comment>Absolute Height defines the total vertical measurement of the building from its lowest underground storey to the highest roof. It should account for all storeys and their heights in this calculation</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Absolute Height</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingHeight -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingHeight">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
        <rdfs:comment>Building Height defines the vertical measurement of the building from the datum to the highest point on the roof or an architectural element.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Building Height</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingMassRatio -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/BuildingMassRatio">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Ratio"/>
        <rdfs:comment>Building Mass Ratio is the ratio of the maximum allowable building volume in relation to the land area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Building Mass Ratio</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/CompetentAuthority -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/CompetentAuthority">
        <rdfs:comment>A competent authority is any public officer or statutory body established by written law with legislative power to make decisions and enforce regulations within their jurisdication.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Competent Authority</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/Datum -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/Datum">
        <rdfs:comment>Datum is a reference point or baseline used as a starting point for measurements or calculations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Datum</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/FloorToFloorHeight -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/FloorToFloorHeight">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
        <rdfs:comment>Floor To Floor Height defines the height from the floor of the current storey to the floor of the next storey.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Floor To Floor Height</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/FrontSetback -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/FrontSetback">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/Setback"/>
        <rdfs:comment>Front Setback applies to the side of the plot that has the main entrance facing the road.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Front Setback</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/GrossPlotRatio -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/GrossPlotRatio">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Ratio"/>
        <rdfs:comment>Gross Plot Ratio is the ratio of maximum allowable Gross Floor Area to the Land Area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Gross Plot Ratio</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/LandUseRegulation">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/appliesTo"/>
                <owl:allValuesFrom rdf:resource="https://www.theworldavatar.com/kg/ontozoning/LandUseType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Land use regulation is a form of specialised planning regulations that provide guidelines to any urban entities based on their land use type. For instance, a Commercial development control plan will apply to zones with commercial zone type. These regulations are designed to address specific land use or development needs associated with their zone uses. Note that these regulations might only provide a range of guidelines for specific restrictions, but individual plots may differ from these guidelines. For instance, Commercial Land Use Type might have a maximum floor-to-floor height of 5m in the type regulation, but specific plots might have a lower maximum number.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Land Use Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/PartyWall -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/PartyWall">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/SideSetback"/>
        <rdfs:comment>PartyWall setback refers to Side setback whose buffer distance is required to be 0m.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Party Wall</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/PlanningRegulation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/appliesTo"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontoplot/Plot"/>
                            <rdf:Description rdf:about="https://www.theworldavatar.com/kg/ontozoning/Zone"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Planning regulations are a set of rules and guidelines established by competent authorities at the local, regional, or national level to control and manage the development and use of land and properties within a specific geographic area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Planning Regulation</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/RearSetback -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/RearSetback">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/Setback"/>
        <rdfs:comment>Rear Setback applies to the side of the plot that is opposite of its front side.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Rear Setback</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/RoadBuffer -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/RoadBuffer">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/Setback"/>
        <rdfs:comment>Road Buffer refers to setbacks related to the road category of the adjacent plot. A plot may have more than one road buffer if it is adjacent to multiple road plots.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Road Buffer</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/RoadCategory -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/RoadCategory"/>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/Setback -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/Setback">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Distance"/>
        <rdfs:comment>Setback defines the distance from the plot boundary that any development can occur.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Setback</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/SideSetback -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/SideSetback">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/Setback"/>
        <rdfs:comment>Side Setback apply to the side of the plot that is not Front nor Rear.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Side Setback</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/SiteCoverage -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/SiteCoverage">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Ratio"/>
        <rdfs:comment>Site Coverage defines the ratio of a land plot that can be occupied or covered by a building or structure. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Site Coverage</rdfs:label>
    </owl:Class>
    


    <!-- https://www.theworldavatar.com/kg/ontoplanningregulation/UseQuantum -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoplanningregulation/UseQuantum">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Percent"/>
        <rdfs:comment>A ratio between the predominant and ancillary allowed land uses within specific land use types, expressed in percentages. For instance, Business 2 land use type allows at least 60% of the floor area to be dedicated for industrial purpose uses and the remaining 40% may be dedicated for ancillary uses such as Showroom, Industrial Canteen, Ancillary Office, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.theworldavatar.com/kg/ontoplanningregulation/"/>
        <rdfs:label>Use Quantum </rdfs:label>
    </owl:Class>
    


