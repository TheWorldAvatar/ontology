<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#"
     xml:base="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:OntoEnergySystem="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#">
    <owl:Ontology rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl">
        <owl:imports rdf:resource="https://github.com/TheWorldAvatar/ontology/raw/refs/heads/main/ontology/ontocape/upper_level/system.owl"/>
        <dc:date>10 September 2026</dc:date>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
        <rdfs:comment>OntoEnergySystem is an ontology developed for representing energy systems.</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#gitCommitHash -->


    <owl:AnnotationProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon -->


    <rdfs:Datatype rdf:about="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedActivePower"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedReactivePower"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitDivision"/>
        <rdfs:comment>The unit ontology will be used to facilitate the unit type. This is something to note power output (eg. Watt(s), KiloWatts(s), MegaWatts(s), etc�). </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasProperty -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasProperty">
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#CommercialElectricityConsumption"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#DomesticElectricityConsumption"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#IndustrialElectricityConsumption"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#TotalElectricityConsumption"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isDirectSubsystemOf -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isDirectSubsystemOf">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#NaturalGasSystem"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#NaturalGasSystem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isPropertyOf -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isPropertyOf">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#enablesElectricityConsumptionOf -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#enablesElectricityConsumptionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#enablesEnergyConsumptionOf"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption"/>
        <rdfs:comment>A relation links an EnergySystem with the electic energy consumption which is met by it. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#enablesEnergyConsumptionOf -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#enablesEnergyConsumptionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasProperty"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption"/>
        <rdfs:comment>A relation links an EnergySystem with the energy consumption which is met by it. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasPowerPlant -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasPowerPlant">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysRealization.owl#PowerGenerator"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl#PowerPlant"/>
        <rdfs:comment>Each generator is associated with a station (power plant). A power plant may have multiple generators, but a generator can only have one power plant. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasRelevantPlace -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasRelevantPlace">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Asset"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#GeographicalArea"/>
        <rdfs:comment>A relation between an asset and its relevant areas. Normally it refers to the area where the asset located in.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#includesConsumption -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#includesConsumption">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption"/>
        <rdfs:comment>A relation between a total consumption and a sub-consumption which is the inverse of isSub-ConsumptionOf</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#isObservedIn -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#isObservedIn">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#Property"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#GeographicalArea"/>
        <rdfs:comment>A relation between a phenomena and its observed object. It is the inverse property of observes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#observes -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#observes">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#GeographicalArea"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#Property"/>
        <rdfs:comment>A relation is the inverse of isObservedIn.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#hasActivePowerGenerated -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#hasActivePowerGenerated">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysRealization.owl#PowerGenerator"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedActivePower"/>
        <rdfs:comment>PowerGenerators generate active power. Furthermore, GeneratedActivePower is explained withing the OntoPowSys ontology, so the connection is here. </rdfs:comment>
        <rdfs:comment>PowerPlants generate active power (PowerGenerators do so with more granularity though). Furthermore, GeneratedActivePower is explained withing the OntoPowSys ontology, so the connection is here. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#hasReactivePowerGenerated -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#hasReactivePowerGenerated">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysRealization.owl#PowerGenerator"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedReactivePower"/>
        <rdfs:comment>PowerGenerators generate reactive power. Furthermore, GeneratedReactivePower is explained withing the OntoPowSys ontology, so the connection is here. </rdfs:comment>
        <rdfs:comment>PowerPlants generate reactive power (PowerGenerators do so with more granularity though). Furthermore, GeneratedReactivePower is explained withing the OntoPowSys ontology, so the connection is here. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl"/>
    </owl:ObjectProperty>
    


    <!-- https://github.com/cambridge-cares/TheWorldAvatar/blob/develop/JPS_Ontology/ontology/ontotimeseries/OntoTimeSeries.owl#hasTimeSeries -->


    <owl:ObjectProperty rdf:about="https://github.com/cambridge-cares/TheWorldAvatar/blob/develop/JPS_Ontology/ontology/ontotimeseries/OntoTimeSeries.owl#hasTimeSeries">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedActivePower"/>
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedReactivePower"/>
        <rdfs:range rdf:resource="https://github.com/cambridge-cares/TheWorldAvatar/blob/develop/JPS_Ontology/ontology/ontotimeseries/OntoTimeSeries.owl#TimeSeries"/>
        <rdfs:comment>The time series ontology will be used to facilitate the quantity output(s). EG. If it is 1 MW, then the units would be MW (MegaWatt(s)), while the quantity would be 1. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://github.com/cambridge-cares/TheWorldAvatar/blob/develop/JPS_Ontology/ontology/ontotimeseries/OntoTimeSeries.owl"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasCode -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A relation between a GeographicalArea and its tag of any types of codes or indexes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasEIC -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasEIC">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl"/>
                    <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontopowsys/PowSysRealization.owl#PowerGenerator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A relation between a Registered Resource EIC (Energy Identification Code) code and a powerplant or generator. These should be unique to each facility and are used throughout Europe. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasLocalAuthorityCode -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasLocalAuthorityCode">
        <rdfs:subPropertyOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasCode"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A relation between AdministrativeDivision and Land Authority code which it is tagged.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasRegisteredResourceName -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasRegisteredResourceName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl"/>
                    <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontopowsys/PowSysRealization.owl#PowerGenerator"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A relation between a Registered Resource Name (BMRS - used throughout the UK), and a powerplant or generator. Note that this should be identical to the NGCBMUnitID (if it exists - also per the BMRS data), so data may also be extracted from there. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasWGS84LatitudeLongitude -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#hasWGS84LatitudeLongitude">
        <rdfs:range rdf:resource="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
        <rdfs:comment>A relation between an object and its Latitude-Longitude coordinates (basde on EPSG 4326, also known as WGS84).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/UnitDivision -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/UnitDivision"/>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#Property -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#Property">
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
    


    <!-- http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#System -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#System">
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#hasActivePowerGenerated"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedActivePower"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#hasReactivePowerGenerated"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysBehavior.owl#GeneratedReactivePower"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl#PowerPlant -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl#PowerPlant">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Asset"/>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoeip/powerplants/PowerPlant.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#AdministrativeDivision -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#AdministrativeDivision">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#GeographicalArea"/>
        <rdfs:comment>A generic name for geographical areas into which a particular, independent sovereign state (country) is divided. Such a unit usually has an administrative authority with the power to take administrative or policy decisions for its area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Asset -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Asset">
        <rdfs:comment>A physical item of property, which is of value and available to meet debts, commitments, or legacies. Normally, asset is persisted by a natural person, company or any organisations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#CommercialElectricityConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#CommercialElectricityConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>One of the components of the Non-DomesticElectricityConsumption which is totally different from IndustrialElectricityConsumption. It specifically refers to the electricity consumed the by nonmanufacturing establishments or agencies primarily engaged in the sale of goods or services. In short, CommercialElectricityConsumption includes the consumption of the service sector. It is highly connected to population growth (as services tend to population serving).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#DomesticElectricityConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#DomesticElectricityConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The rest part of TotalElectricityConsumption which refers to the electricity used by domestic purposes, conceptually opposites to Non-DomesticElectricityConsumption.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem">
        <owl:equivalentClass rdf:resource="http://www.theworldavatar.com/ontology/ontopowsys/PowSysRealization.owl#PowerSystem"/>
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isDirectSubsystemOf"/>
                <owl:someValuesFrom rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A network of electrical components deployed to supply, transfer, and use electric power.  An example of a power system is the electrical grid that provides power to homes, industries, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isPropertyOf"/>
                <owl:someValuesFrom rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricPowerSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The form of energy consumption that uses electric energy. Electric energy consumption is the actual energy demand made on existing electricity supply which is not equal to the nominal demanding.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergyConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#Property"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isPropertyOf"/>
                <owl:someValuesFrom rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The amount of energy or power used. The consumer can be of any types includes a given area. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#System"/>
        <rdfs:comment>A system primarily designed to supply energy-services to end-users. All components of energy system are related to the production, conversion, delivery, and use of energy. The energy type can be of variety includes both primary and secondary energy sources.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#GeographicalArea -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#GeographicalArea">
        <rdfs:comment>A demarcated area of the Earth.The boundary of the area is of arbitrary which means it can be official, like the border of country,  or non-offical ones forming from any conventional rules or even the boundaries with no underlying meaning.  </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#IndustrialElectricityConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#IndustrialElectricityConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>One of the components of the Non-DomesticElectricityConsumption, which refers to the electric energy is predominantly used for industrial purpose, such as production, as well as for lighting and other business uses in the manufacturing industries.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#NaturalGasSystem -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#NaturalGasSystem">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#EnergySystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#isDirectSubsystemOf"/>
                <owl:someValuesFrom rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#NaturalGasSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A transmission network (system) of gas pipelines that supply gas to end-users from natural gas terminals situated on the coast, and to gas distribution companies that supply commercial and domestic users.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#includesConsumption"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#CommercialElectricityConsumption"/>
                            <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#IndustrialElectricityConsumption"/>
                            <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A part of TotalElectricityConsumption which refers to the electricity consumed by non-domestic consumers or purposes. It can be subdivided into  IndustrialElectricityConsumption and IndustrialElectricityConsumption.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#TotalElectricityConsumption -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#TotalElectricityConsumption">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#ElectricityConsumption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#includesConsumption"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#DomesticElectricityConsumption"/>
                            <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#Non-DomesticElectricityConsumption"/>
                            <rdf:Description rdf:about="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl#TotalElectricityConsumption"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#hasValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontocape/upper_level/system.owl#ScalarValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The accumulated amount of ElectricityConsumption over a time period such as on a year base. It is composed of both DomesticElectricityConsumption and Non-DomesticElectricityConsumption.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontoenergysystem/OntoEnergySystem.owl"/>
    </owl:Class>
    


