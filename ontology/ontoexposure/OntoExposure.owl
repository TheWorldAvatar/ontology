    <!-- https://www.theworldavatar.com/kg/ontoexposure/Area -->


    <owl:Class rdf:about="https://www.theworldavatar.com/kg/ontoexposure/Area">
        <rdfs:subClassOf rdf:resource="https://www.theworldavatar.com/kg/ontoexposure/Calculation"/>
