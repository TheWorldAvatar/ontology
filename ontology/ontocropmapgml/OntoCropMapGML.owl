     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:OntoCropMapGML="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#">
    <owl:Ontology rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl">
        <dc:date>14 September 2026</dc:date>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
        <rdfs:comment>An ontology developed for representing crop maps.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


