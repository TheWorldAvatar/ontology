     -->


    


    <!-- http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType">
        <rdfs:comment>EnvelopeType defines an extent using a pair of positions defining opposite corners in arbitrary dimensions. Here, the lower left corner point and upper right corner point are used.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#boundedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasLucode"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.theworldavatar.com/ontology/ontolanduse/OntoLandUse.owl#LandUseCode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A geomtrical object which has a Land Use Code (LUcode).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/ontology/ontolanduse/OntoLandUse.owl#LandUseCode -->


    <owl:Class rdf:about="http://www.theworldavatar.com/ontology/ontolanduse/OntoLandUse.owl#LandUseCode"/>
</rdf:RDF>



