    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#gitCommitHash -->


    <owl:AnnotationProperty rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#gitCommitHash"/>
    


    <!-- 
