    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://ns.inria.fr/ast/sql/index.html#ObjectIdentifier -->


    <owl:DatatypeProperty rdf:about="http://ns.inria.fr/ast/sql/index.html#ObjectIdentifier">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>An identifier unique within the EnvelopeType which refers to a specific CropMap.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://ns.inria.fr/ast/sql"/>
    </owl:DatatypeProperty>
    


    <!-- http://open.vocab.org/terms/length -->


    <owl:DatatypeProperty rdf:about="http://open.vocab.org/terms/length">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Length is a measure of distance. This value refers to the perimeter of the CropMap in metres.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://open.vocab.org/terms"/>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.datex.org/terms/#centrePoint -->


    <owl:DatatypeProperty rdf:about="http://vocab.datex.org/terms/#centrePoint">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
        <rdfs:comment>Centre point of a CropMap as identified by the Rural Payments Agency. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.datex.org/terms"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#lowerCornerPoint -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#lowerCornerPoint">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType"/>
        <rdfs:range rdf:resource="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
        <rdfs:comment>The lowermost vertex of the EnvelopeType.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#srsname -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#srsname">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the coordinate system which the EnvelopeType refers to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#upperCornerPoint -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#upperCornerPoint">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType"/>
        <rdfs:range rdf:resource="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
        <rdfs:comment>The uppermost vertex of the EnvelopeType.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasCromeID -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasCromeID">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A CROMEID is assigned as specified by the Rural Payments Agency (RPA) for a CropMap. The CROMEID is the unique identifier assigned to each CropMap, consisting of the letters RPA and a twelve digit number, which are the Easting and Northing coordinates of the centroid of the cell. For example a CropMap with CROMEID RPAXXXXXXYYYYYY would have a centre point with Easting XXXXXX and Northing YYYYYY.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasGeometry -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasGeometry">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/datatype/POLYGON-2-14"/>
        <rdfs:comment>Relates a CropMap to its vertex coordinates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasReferenceDate -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasReferenceDate">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The reference date is the date or date range of the images referenced to assign the Land Use Code to the CROME CropMap. The date format used is YYYYMMDD e.g. 20181121. The value is expected to remain constant for each CropMap in a CROME release.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#srsDimension -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#srsDimension">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Specifies the number of dimensions which the EnvelopeType has.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl"/>
    </owl:DatatypeProperty>
    


    <!-- https://dbpedia.org/ontology/area -->


    <owl:DatatypeProperty rdf:about="https://dbpedia.org/ontology/area">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Area is the quantity that expresses the extent of a two-dimensional region, shape, or planar lamina, in the plane. This value refers to the area of the CropMap in metres squared.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/ontology"/>
    </owl:DatatypeProperty>
    


