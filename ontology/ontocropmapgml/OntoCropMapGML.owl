    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon -->


    <rdfs:Datatype rdf:about="http://www.bigdata.com/rdf/geospatial/literals/v1#lat-lon"/>
    


    <!-- http://www.theworldavatar.com/ontology/datatype/POLYGON-2-14 -->


    <rdfs:Datatype rdf:about="http://www.theworldavatar.com/ontology/datatype/POLYGON-2-14"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#boundedBy -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#boundedBy">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl#EnvelopeType"/>
        <rdfs:comment>Specifies which EnvelopType the CropMap belongs to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocitygml/citieskg/OntoCityGML.owl"/>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasLucode -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#hasLucode">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl#CropMap"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/ontology/ontolanduse/OntoLandUse.owl#LandUseCode"/>
        <rdfs:comment>Specifies which Land Use Code (LUcode) is assigned to this CropMap.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/ontology/ontocropmapgml/OntoCropMapGML.owl"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
